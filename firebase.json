{
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "runtime": "python311",
      "ignore": [
        "venv",
        ".venv",
        "__pycache__",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "functions",
      "codebase": "notifications"
    }
  ],
  "hosting": {
    "public": "frontend/dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/ctf{,/**}",
        "function": {
          "functionId": "ctf",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "function": "api"
      },
      { "source": "/login", "destination": "/app.html" },
      { "source": "/signup", "destination": "/app.html" },
      { "source": "/dashboard", "destination": "/app.html" },
      { "source": "/account", "destination": "/app.html" },
      { "source": "/scans{,/**}", "destination": "/app.html" },
      { "source": "/layers{,/**}", "destination": "/app.html" },
      { "source": "/app{,/**}", "destination": "/app.html" },
      { "source": "/intentscan", "destination": "/app.html" },
      { "source": "/enforce", "destination": "/app.html" },
      { "source": "/demo", "destination": "/app.html" }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store"
          }
        ],
        "regex": "^/ctf(?:/(?:challenges|agentic|leaderboard|aisywlc|community|learn|labs|research|evolution|docs|privacy|progress)(?:/.*)?)?/?$"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
